using UnityEngine;

public class Checkpoint : MonoBehaviour
{
    [Tooltip("Ordem deste checkpoint na fase (0, 1, 2...) — evita retroceder o progresso")]
    public int indice;

    // Uso OnTriggerEnter (não OnCollisionEnter) porque o checkpoint não deve
    // ter colisão física, só detectar a passagem do player.
    // IMPORTANTE: o Collider deste GameObject precisa estar marcado como "Is Trigger" no Inspector.
    private void OnTriggerEnter(Collider other)
    {
        if (!other.CompareTag("Player")) return;

        // Só atualiza se for um checkpoint mais avançado que o atual
        if (indice <= CheckpointManager.indiceCheckpoint) return;

        CheckpointManager.indiceCheckpoint = indice;
        CheckpointManager.posicaoCheckpoint = transform.position;
        CheckpointManager.rotacaoYCheckpoint = transform.eulerAngles.y;
    }
}
