-- Script deve ficar dentro da parte chamada "trofeu", no Workspace

-- Pega a referência da própria parte "trofeu" (o objeto pai deste script)
local trofeu = script.Parent

-- Variável de controle para evitar que o evento dispare várias vezes seguidas
-- enquanto o jogador continua encostando na parte
local debounce = false

-- Conecta a função ao evento "Touched", que dispara sempre que algo toca na parte
trofeu.Touched:Connect(function(hit)
	-- "hit" é a parte que tocou no trofeu (pode ser uma perna, braço, etc)
	-- hit.Parent é o modelo do personagem que tocou
	local character = hit.Parent

	-- Verifica se esse personagem pertence a um jogador (evita bugs com NPCs, itens, etc)
	local player = game.Players:GetPlayerFromCharacter(character)

	-- Só executa se for um jogador válido E se o debounce estiver liberado
	if player and not debounce then
		-- Ativa o debounce para bloquear novos disparos até o final desta execução
		debounce = true

		-- Espera o PlayerGui existir (garante que o jogador já carregou a interface)
		local playerGui = player:WaitForChild("PlayerGui")

		-- Espera o ScreenGui existir dentro do PlayerGui
		local screenGui = playerGui:WaitForChild("ScreenGui")

		-- Espera o TextLabel existir dentro do ScreenGui
		local textLabel = screenGui:WaitForChild("TextLabel")

		-- Torna o texto visível
		textLabel.Visible = true

		-- Aguarda 5 segundos com o texto visível
		wait(5)

		-- Depois dos 5 segundos, torna o texto invisível novamente
		textLabel.Visible = false


		-- Procura o objeto SpawnLocation original do mapa dentro do Workspace
		-- (esse é o "ponto de spawn" padrão que o Roblox usa quando o personagem nasce)
		local spawnLocation = workspace:FindFirstChildOfClass("SpawnLocation")

		-- Verifica se o personagem ainda existe e se o SpawnLocation foi encontrado
		if character and spawnLocation then
			-- Pega a parte central do personagem, usada para movê-lo no mundo
			local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

			if humanoidRootPart then
				-- Move o personagem para a posição do spawn, um pouco acima do chão
				-- (soma um Vector3 na altura para evitar que ele fique preso dentro da parte)
				humanoidRootPart.CFrame = spawnLocation.CFrame + Vector3.new(0, 3, 0)
			end
		end

		-- Aguarda mais um instante antes de liberar o debounce
		-- (evita reativação imediata caso o jogador ainda esteja encostando)
		wait(1)

		-- Libera o debounce, permitindo que o evento dispare novamente no futuro
		debounce = false
	end
end)
