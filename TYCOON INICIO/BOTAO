-- ========================================
-- SCRIPT: BOTÃO DE COMPRA
-- Esconde os itens da pasta até o dono da base comprar.
-- Só aparece depois que o botão pai (ou o BotaoDono) for comprado.
-- Esconde tudo de novo quando a base fica sem dono.
-- Local: dentro da peça Botao (ex: Tycoons.Tycoon1.Botao1.Botao)
-- IMPORTANTE: toda peça de botão precisa se chamar "Botao"
-- ========================================

local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local Economia = require(ServerScriptService.Economia)

-- a peça do botão, a pasta dele e a base onde ele está
local botao = script.Parent
local pasta = botao.Parent
local tycoon = Economia.acharTycoon(botao)

-- ========================================
-- CONFIGURAÇÕES DO BOTÃO
-- ========================================
local preco = 10              -- quanto custa liberar os itens desta pasta
local ancorarAoComprar = true -- true: tudo fica preso no lugar depois da compra

-- ========================================
-- VARIÁVEIS DE CONTROLE
-- ========================================
local jaComprado = false  -- se este botão já foi comprado
local liberado = true     -- se este botão pode ser comprado agora
local originalItens = {}  -- como cada item da pasta era no Studio
local originalBotao = {}  -- como o botão era no Studio

-- tipos de objeto que ligam e desligam
local tiposComEnabled = {
	"Script", "ParticleEmitter", "Light", "Fire", "Smoke", "Sparkles",
	"Beam", "Trail", "SurfaceGui", "BillboardGui", "ProximityPrompt",
}

-- valor de cada propriedade quando o objeto está escondido
local escondido = {
	Transparency = 1,
	CanCollide = false,
	CanTouch = false,
	CanQuery = false,
	Anchored = true,
	Enabled = false,
	Playing = false,
}

-- ========================================
-- FUNÇÕES DE AJUDA
-- ========================================

-- diz se o objeto é de um tipo que liga e desliga
local function temEnabled(objeto)
	for _, tipo in ipairs(tiposComEnabled) do
		if objeto:IsA(tipo) then
			return true
		end
	end
	return false
end

-- diz se o objeto é o botão ou está dentro dele
local function ehDoBotao(objeto)
	return objeto == botao or objeto:IsDescendantOf(botao)
end

-- diz se o objeto pertence a um botão de dentro desta pasta
local function ehDeOutroBotao(objeto)
	local atual = objeto.Parent
	while atual and atual ~= pasta do
		local outro = atual:FindFirstChild("Botao")
		if outro and outro ~= botao and outro:IsA("BasePart") then
			return true
		end
		atual = atual.Parent
	end
	return false
end

-- devolve o botão pai (outro Botao acima, ou o BotaoDono da base)
local function acharBotaoPai()
	local atual = pasta.Parent
	while atual and atual ~= game do
		local outro = atual:FindFirstChild("Botao") or atual:FindFirstChild("BotaoDono")
		if outro and outro:IsA("BasePart") then
			return outro
		end
		atual = atual.Parent
	end
	return nil
end

-- anota as propriedades do objeto como estão no Studio
local function anotar(objeto, tabela)
	if objeto:IsA("BasePart") then
		tabela[objeto] = {
			Transparency = objeto.Transparency,
			CanCollide = objeto.CanCollide,
			CanTouch = objeto.CanTouch,
			CanQuery = objeto.CanQuery,
			Anchored = objeto.Anchored,
		}
	elseif objeto:IsA("Decal") then
		tabela[objeto] = { Transparency = objeto.Transparency }
	elseif objeto:IsA("Sound") then
		tabela[objeto] = { Playing = objeto.Playing }
	elseif temEnabled(objeto) then
		tabela[objeto] = { Enabled = objeto.Enabled }
	end
end

-- esconde tudo o que está na tabela
local function ocultar(tabela)
	for objeto, propriedades in pairs(tabela) do
		if objeto.Parent then
			for nome in pairs(propriedades) do
				objeto[nome] = escondido[nome]
			end
		end
	end
end

-- devolve as propriedades anotadas de um objeto
local function restaurar(objeto, propriedades)
	for nome, valor in pairs(propriedades) do
		objeto[nome] = valor
	end
	if ancorarAoComprar and objeto:IsA("BasePart") then
		objeto.Anchored = true
	end
end

-- mostra tudo o que está na tabela (scripts por último)
local function mostrar(tabela)
	local scripts = {}
	for objeto, propriedades in pairs(tabela) do
		if objeto.Parent then
			if objeto:IsA("Script") then
				table.insert(scripts, objeto)
			else
				restaurar(objeto, propriedades)
			end
		end
	end
	for _, s in ipairs(scripts) do
		restaurar(s, tabela[s])
	end
end

-- mostra o botão para poder ser comprado
local function aparecer()
	if liberado or jaComprado then return end
	liberado = true
	mostrar(originalBotao)
end

-- volta o botão e os itens para o começo
local function resetar()
	if jaComprado then
		ocultar(originalItens)
	end
	jaComprado = false
	liberado = false
	ocultar(originalBotao)
	botao:SetAttribute("Comprado", nil)
end

-- ========================================
-- QUANDO O JOGO COMEÇA
-- ========================================

-- anota os itens desta pasta
for _, objeto in ipairs(pasta:GetDescendants()) do
	if not ehDoBotao(objeto) and not ehDeOutroBotao(objeto) then
		anotar(objeto, originalItens)
	end
end

-- anota o botão e o que está dentro dele (menos este script)
anotar(botao, originalBotao)
for _, objeto in ipairs(botao:GetDescendants()) do
	if objeto ~= script then
		anotar(objeto, originalBotao)
	end
end

-- esconde os itens
ocultar(originalItens)

-- segue o botão pai: aparece quando ele é comprado, reseta quando ele reseta
local botaoPai = acharBotaoPai()

if botaoPai then
	local function verificarPai()
		if botaoPai:GetAttribute("Comprado") then
			aparecer()
		else
			resetar()
		end
	end

	botaoPai:GetAttributeChangedSignal("Comprado"):Connect(verificarPai)
	verificarPai()
end

-- ========================================
-- EVENTO: compra quando o dono toca no botão
-- ========================================
botao.Touched:Connect(function(hit)
	if jaComprado or not liberado then return end

	local jogador = Players:GetPlayerFromCharacter(hit.Parent)
	if not jogador then return end

	-- só o dono da base compra
	if not Economia.ehDono(tycoon, jogador) then return end

	local carteira = Economia.carteiras[jogador.UserId] or 0

	if carteira >= preco then
		jaComprado = true
		Economia.carteiras[jogador.UserId] = carteira - preco

		mostrar(originalItens)
		ocultar(originalBotao)

		-- avisa os botões de dentro que podem aparecer
		botao:SetAttribute("Comprado", true)

		print(jogador.Name .. " comprou por " .. preco)
	else
		print(jogador.Name .. " não tem dinheiro suficiente")
	end
end)
