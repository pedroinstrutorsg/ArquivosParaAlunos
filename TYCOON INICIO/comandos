local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local historico = game:GetService("ChangeHistoryService")
local pastaTycoons = workspace:FindFirstChild("Tycoons")
local blocos = ServerStorage:FindFirstChild("Blocos")
local linhas = {}
local corrigidos = 0
local manuais = 0
local function linha(texto)
	table.insert(linhas, { "info", texto })
end
local function corrigido(texto)
	corrigidos += 1
	table.insert(linhas, { "info", "  [CORRIGIDO] " .. texto })
end
local function manual(texto)
