-- ========================================
-- SCRIPT: BOTÃO DE COMPRA DE ITENS
-- Vende as armas e poderes (Tools) que estão na pasta.
-- Funciona como o botão de compra, mas não some depois da compra.
-- Local: dentro da peça BotaoCompra (ex: Tycoons.Tycoon1.Botao1.BotaoCompra.BotaoCompra)
-- IMPORTANTE: a peça e a pasta precisam se chamar "BotaoCompra"
-- ========================================

local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local Economia = require(ServerScriptService.Economia)

-- a peça do botão, a pasta dele e a base onde ele está
local botao = script.Parent
local pasta = botao.Parent
local tycoon = Economia.acharTycoon(botao)

-- ========================================
-- CONFIGURAÇÕES DO BOTÃO
-- ========================================
local preco = 0                     -- quanto custa
local nomeDoItem = "Espada"         -- nome que aparece em cima do botão
local mostrarNaVitrine = true       -- true: uma cópia de enfeite do item aparece na pasta depois da compra
local esconderTextoAoComprar = true -- true: o texto some depois da compra
local textoDepoisDaCompra = ""      -- texto depois da compra, se não esconder ("" = não muda)
local manterAoMorrer = true         -- true: os itens voltam depois que o jogador morre
local ancorarAoComprar = true       -- true: as peças da pasta ficam presas no lugar depois da compra
local alturaDoTexto = 5             -- altura do texto acima do botão
local tamanhoDoTexto = 0.5            -- tamanho do texto (1 = normal, 2 = dobro, 0.5 = metade)
local distanciaDoTexto = 60         -- distância máxima para ver o texto
local corDoTexto = Color3.fromRGB(255, 255, 255)  -- cor do texto

-- ========================================
-- VARIÁVEIS DE CONTROLE
-- ========================================
local jaComprado = false  -- se este botão já foi comprado
local liberado = true     -- se este botão pode ser comprado agora
local originalItens = {}  -- como cada peça da pasta era no Studio
local originalBotao = {}  -- como o botão era no Studio
local itensDaLoja = {}    -- armas e poderes que este botão vende
local placaDoBotao = nil  -- placa do texto em cima do botão
local textoDoBotao = nil  -- texto da placa
local textoInicial = ""   -- texto com o nome e o preço

-- nomes das peças que funcionam como botão
local nomesDeBotao = { "Botao", "BotaoCompra" }

-- tipos de objeto que ligam e desligam
local tiposComEnabled = {
	"Script", "ParticleEmitter", "Light", "Fire", "Smoke", "Sparkles",
	"Beam", "Trail", "SurfaceGui", "BillboardGui", "ProximityPrompt",
}

-- valor de cada propriedade quando o objeto está escondido
local escondido = {
	Transparency = 1,
	CanCollide = false,
	CanTouch = false,
	CanQuery = false,
	Anchored = true,
	Enabled = false,
	Playing = false,
}

-- ========================================
-- FUNÇÕES
-- ========================================

-- cria o texto com o nome e o preço em cima do botão
local function criarTexto()
	placaDoBotao = Instance.new("BillboardGui")
	placaDoBotao.Name = "TextoBotao"
	placaDoBotao.Size = UDim2.new(0, 200 * tamanhoDoTexto, 0, 60 * tamanhoDoTexto)
	placaDoBotao.StudsOffset = Vector3.new(0, alturaDoTexto, 0)
	placaDoBotao.MaxDistance = distanciaDoTexto
	placaDoBotao.Parent = botao

	textoDoBotao = Instance.new("TextLabel")
	textoDoBotao.Size = UDim2.new(1, 0, 1, 0)
	textoDoBotao.BackgroundTransparency = 1
	textoDoBotao.TextScaled = true
	textoDoBotao.Font = Enum.Font.GothamBold
	textoDoBotao.TextColor3 = corDoTexto
	textoDoBotao.TextStrokeTransparency = 0
	textoDoBotao.Parent = placaDoBotao

	if preco == 0 then
		textoInicial = nomeDoItem .. "\nGrátis"
	else
		textoInicial = nomeDoItem .. "\n$" .. preco
	end
	textoDoBotao.Text = textoInicial
end

-- diz se o objeto é de um tipo que liga e desliga
local function temEnabled(objeto)
	for _, tipo in ipairs(tiposComEnabled) do
		if objeto:IsA(tipo) then
			return true
		end
	end
	return false
end

-- diz se o objeto é o botão ou está dentro dele
local function ehDoBotao(objeto)
	return objeto == botao or objeto:IsDescendantOf(botao)
end

-- diz se o objeto pertence a um botão de dentro desta pasta
local function ehDeOutroBotao(objeto)
	local atual = objeto.Parent
	while atual and atual ~= pasta do
		for _, nome in ipairs(nomesDeBotao) do
			local outro = atual:FindFirstChild(nome)
			if outro and outro ~= botao and outro:IsA("BasePart") then
				return true
			end
		end
		atual = atual.Parent
	end
	return false
end

-- devolve o botão pai (um botão acima, ou o BotaoDono da base)
local function acharBotaoPai()
	local atual = pasta.Parent
	while atual and atual ~= game do
		local outro = atual:FindFirstChild("Botao") or atual:FindFirstChild("BotaoCompra") or atual:FindFirstChild("BotaoDono")
		if outro and outro:IsA("BasePart") then
			return outro
		end
		atual = atual.Parent
	end
	return nil
end

-- cria uma cópia de enfeite do item no lugar dele (sem scripts e sem poder pegar)
local function criarVitrine(item)
	local vitrine = Instance.new("Model")
	vitrine.Name = "Vitrine_" .. item.Name

	local copia = item:Clone()
	for _, filho in ipairs(copia:GetChildren()) do
		filho.Parent = vitrine
	end
	copia:Destroy()

	for _, objeto in ipairs(vitrine:GetDescendants()) do
		if objeto:IsA("LuaSourceContainer") or objeto:IsA("Sound") then
			objeto:Destroy()
		elseif objeto:IsA("BasePart") then
			objeto.Anchored = true
			objeto.CanCollide = false
			objeto.CanTouch = false
		end
	end

	vitrine.Parent = item.Parent
end

-- tira as armas e poderes da pasta e guarda no ServerStorage
local function guardarItens()
	local guarda = ServerStorage:FindFirstChild("ItensDosBotoes")
	if not guarda then
		guarda = Instance.new("Folder")
		guarda.Name = "ItensDosBotoes"
		guarda.Parent = ServerStorage
	end

	for _, objeto in ipairs(pasta:GetDescendants()) do
		if objeto:IsA("Tool") and not ehDoBotao(objeto) and not ehDeOutroBotao(objeto) then
			table.insert(itensDaLoja, objeto)
		end
	end

	for _, item in ipairs(itensDaLoja) do
		if mostrarNaVitrine then
			criarVitrine(item)
		end

		-- o item entregue ao jogador não pode ficar preso no lugar
		for _, peca in ipairs(item:GetDescendants()) do
			if peca:IsA("BasePart") then
				peca.Anchored = false
			end
		end

		item.Parent = guarda
	end
end

-- diz se o jogador já tem um item com esse nome
local function jaTem(jogador, nome)
	local lugares = { jogador:FindFirstChild("Backpack"), jogador.Character }
	for _, lugar in ipairs(lugares) do
		local achado = lugar and lugar:FindFirstChild(nome)
		if achado and achado:IsA("Tool") then
			return true
		end
	end
	return false
end

-- entrega as armas e poderes para o jogador (um de cada)
local function entregarItens(jogador)
	for _, item in ipairs(itensDaLoja) do
		local mochila = jogador:FindFirstChild("Backpack")
		if mochila and not jaTem(jogador, item.Name) then
			local copia = item:Clone()
			copia.CanBeDropped = false
			copia.Parent = mochila
		end

		local guardaDoJogador = jogador:FindFirstChild("StarterGear")
		if manterAoMorrer and guardaDoJogador and not guardaDoJogador:FindFirstChild(item.Name) then
			local copia = item:Clone()
			copia.CanBeDropped = false
			copia.Parent = guardaDoJogador
		end
	end
end

-- anota as propriedades do objeto como estão no Studio
local function anotar(objeto, tabela)
	if objeto:IsA("BasePart") then
		tabela[objeto] = {
			Transparency = objeto.Transparency,
			CanCollide = objeto.CanCollide,
			CanTouch = objeto.CanTouch,
			CanQuery = objeto.CanQuery,
			Anchored = objeto.Anchored,
		}
	elseif objeto:IsA("Decal") then
		tabela[objeto] = { Transparency = objeto.Transparency }
	elseif objeto:IsA("Sound") then
		tabela[objeto] = { Playing = objeto.Playing }
	elseif temEnabled(objeto) then
		tabela[objeto] = { Enabled = objeto.Enabled }
	end
end

-- esconde tudo o que está na tabela
local function ocultar(tabela)
	for objeto, propriedades in pairs(tabela) do
		if objeto.Parent then
			for nome in pairs(propriedades) do
				objeto[nome] = escondido[nome]
			end
		end
	end
end

-- devolve as propriedades anotadas de um objeto
local function restaurar(objeto, propriedades)
	for nome, valor in pairs(propriedades) do
		objeto[nome] = valor
	end
	if ancorarAoComprar and objeto:IsA("BasePart") then
		objeto.Anchored = true
	end
end

-- mostra tudo o que está na tabela (scripts por último)
local function mostrar(tabela)
	local scripts = {}
	for objeto, propriedades in pairs(tabela) do
		if objeto.Parent then
			if objeto:IsA("Script") then
				table.insert(scripts, objeto)
			else
				restaurar(objeto, propriedades)
			end
		end
	end
	for _, s in ipairs(scripts) do
		restaurar(s, tabela[s])
	end
end

-- mostra o botão para poder ser comprado
local function aparecer()
	if liberado then return end
	liberado = true
	mostrar(originalBotao)
end

-- volta o botão e os itens para o começo
local function resetar()
	if jaComprado then
		ocultar(originalItens)
	end
	jaComprado = false
	liberado = false
	ocultar(originalBotao)
	textoDoBotao.Text = textoInicial
	botao:SetAttribute("Comprado", nil)
end

-- muda o texto do botão depois da compra
local function textoDaCompra()
	if esconderTextoAoComprar then
		placaDoBotao.Enabled = false
	elseif textoDepoisDaCompra ~= "" then
		textoDoBotao.Text = textoDepoisDaCompra
	end
end

-- compra quando o dono toca no botão (depois de comprado, devolve o que faltar)
local function tentarComprar(hit)
	if not liberado then return end

	local jogador = Players:GetPlayerFromCharacter(hit.Parent)
	if not jogador then return end

	-- só o dono da base compra
	if not Economia.ehDono(tycoon, jogador) then return end

	if jaComprado then
		entregarItens(jogador)
		return
	end

	local carteira = Economia.carteiras[jogador.UserId] or 0

	if carteira >= preco then
		jaComprado = true
		Economia.carteiras[jogador.UserId] = carteira - preco

		mostrar(originalItens)
		entregarItens(jogador)
		textoDaCompra()

		-- avisa os botões de dentro que podem aparecer
		botao:SetAttribute("Comprado", true)

		print(jogador.Name .. " comprou " .. nomeDoItem .. " por " .. preco)
	else
		print(jogador.Name .. " não tem dinheiro suficiente")
	end
end

-- ========================================
-- QUANDO O JOGO COMEÇA
-- ========================================

-- apaga placas antigas feitas à mão e cria o texto
for _, objeto in ipairs(botao:GetChildren()) do
	if objeto:IsA("BillboardGui") or objeto:IsA("TextLabel") then
		objeto:Destroy()
	end
end
criarTexto()

-- guarda as armas e poderes (e cria a vitrine) antes de anotar o resto
guardarItens()

-- anota as peças desta pasta
for _, objeto in ipairs(pasta:GetDescendants()) do
	if not ehDoBotao(objeto) and not ehDeOutroBotao(objeto) then
		anotar(objeto, originalItens)
	end
end

-- anota o botão e o que está dentro dele (menos este script)
anotar(botao, originalBotao)
for _, objeto in ipairs(botao:GetDescendants()) do
	if objeto ~= script then
		anotar(objeto, originalBotao)
	end
end

-- esconde as peças da pasta
ocultar(originalItens)

-- segue o botão pai: aparece quando ele é comprado, reseta quando ele reseta
local botaoPai = acharBotaoPai()

if botaoPai then
	local function verificarPai()
		if botaoPai:GetAttribute("Comprado") then
			aparecer()
		else
			resetar()
		end
	end

	botaoPai:GetAttributeChangedSignal("Comprado"):Connect(verificarPai)
	verificarPai()
end

-- liga a compra ao toque no botão
botao.Touched:Connect(tentarComprar)
