-- ========================================
-- SCRIPT: DESTINO FINAL
-- Vende o bloco que encosta aqui e manda o valor para o armazém da base
-- Local: dentro da peça DestinoFinal
-- ========================================

local ServerScriptService = game:GetService("ServerScriptService")
local Economia = require(ServerScriptService.Economia)

-- a peça do destino e a base onde ele está
local destino = script.Parent
local tycoon = Economia.acharTycoon(destino)

-- ========================================
-- CONFIGURAÇÕES DO DESTINO
-- ========================================
local tempoAteSumir = 1  -- segundos entre o bloco tocar e sumir

-- vende o bloco que encostou
destino.Touched:Connect(function(hit)
	local valor = hit:GetAttribute("Valor")
	if not valor then return end

	-- tira a etiqueta para o bloco não ser vendido 2x
	hit:SetAttribute("Valor", nil)

	task.wait(tempoAteSumir)
	hit:Destroy()

	-- só guarda o dinheiro se a base ainda tiver dono
	if tycoon:GetAttribute("Dono") then
		Economia.adicionarAoArmazem(tycoon, valor)
		print("Bloco vendido por " .. valor .. "! Armazém: " .. Economia.pegarArmazem(tycoon))
	end
end)
