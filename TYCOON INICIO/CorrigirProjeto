FONTES.PlacaDono = [===[
-- ========================================
-- SCRIPT: PLACA DO DONO
-- Mostra quem é o dono da base e faz o dono
-- renascer na frente da placa quando morrer
-- Local: Tycoons.TycoonX.PlacaDono
-- ========================================

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local Economia = require(ServerScriptService.Economia)

-- a placa e a base onde ela está
local placa = script.Parent
local tycoon = Economia.acharTycoon(placa)

-- ========================================
-- CONFIGURAÇÕES DO TEXTO
-- ========================================
local textoLivre = "Base livre"                     -- texto quando a base não tem dono
local textoDono = "Base de"                         -- texto antes do nome do dono
local quebrarLinha = true                           -- true: nome do dono na linha de baixo
local usarApelido = false                           -- true: mostra o apelido (DisplayName) em vez do nome
local tamanhoDoTexto = 0                            -- tamanho do texto (0 = automático, ocupa a placa toda)
local fonte = Enum.Font.GothamBold                  -- fonte do texto
local corDoTexto = Color3.fromRGB(255, 255, 255)    -- cor do texto
local mostrarContorno = true                        -- true: contorno em volta das letras
local corDoContorno = Color3.fromRGB(0, 0, 0)       -- cor do contorno
local corDoFundo = Color3.fromRGB(0, 0, 0)          -- cor do fundo do texto
local transparenciaDoFundo = 1                      -- fundo (0 = sólido, 1 = sem fundo)
local ladoDoTexto = Enum.NormalId.Front             -- lado da placa onde fica o texto

-- ========================================
-- CONFIGURAÇÕES DO RENASCIMENTO
-- ========================================
local renascerNaPlaca = true   -- true: o dono renasce na frente da placa
local distanciaRenascer = 5    -- distância da placa onde o dono renasce
local alturaRenascer = 3       -- altura do renascimento em relação ao centro da placa

-- ========================================
-- VARIÁVEIS DE CONTROLE
-- ========================================
local conexaoRenascer = nil  -- ligação com o renascimento do dono atual
local texto = nil            -- texto da placa

