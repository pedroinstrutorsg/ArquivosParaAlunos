-- ========================================
-- CORREÇÃO
-- ========================================
return function()
	local ServerScriptService = game:GetService("ServerScriptService")
	local ServerStorage = game:GetService("ServerStorage")
	local historico = game:GetService("ChangeHistoryService")

	local pastaTycoons = workspace:FindFirstChild("Tycoons")  -- pasta das bases
	local blocos = ServerStorage:FindFirstChild("Blocos")     -- pasta dos moldes

	local linhas = {}     -- linhas do relatório
	local corrigidos = 0  -- quantidade de correções feitas
	local manuais = 0     -- quantidade de coisas para fazer à mão

	-- scripts que precisam ficar dentro de uma peça
	local precisaDePeca = {
		Botao = true, BotaoCompra = true, BotaoDono = true, Gerador = true, Esteira = true,
		Upgrade = true, DestinoFinal = true, Coletor = true, PainelArmazem = true, PlacaDono = true,
	}

	-- scripts que precisam ficar dentro de uma base
	local precisaDeBase = {
		Botao = true, BotaoCompra = true, BotaoDono = true, DestinoFinal = true,
		Coletor = true, PainelArmazem = true, PlacaDono = true, PortaLaser = true,
	}

	-- adiciona uma linha comum ao relatório
	local function linha(texto)
		table.insert(linhas, { "info", texto })
	end

	-- adiciona um título de seção
	local function titulo(texto)
		linha("")
		linha("==== " .. texto .. " ====")
	end

	-- adiciona uma correção feita
	local function corrigido(texto)
		corrigidos += 1
		table.insert(linhas, { "info", "  [CORRIGIDO] " .. texto })
	end

	-- adiciona algo para fazer à mão
	local function manual(texto)
		manuais += 1
		table.insert(linhas, { "aviso", "  [FAZER À MÃO] " .. texto })
	end

	-- diz se o texto tem um trecho
	local function tem(texto, trecho)
		return texto:find(trecho, 1, true) ~= nil
	end

	-- caminho do objeto sem o começo "Workspace.Tycoons."
	local function nomeCurto(obj)
		local nome = obj:GetFullName():gsub("^Workspace%.Tycoons%.", "")
		return nome
	end

	-- devolve a base onde o objeto está (ou nil)
	local function baseDe(obj)
		if not pastaTycoons then return nil end
		local atual = obj
		while atual and atual.Parent ~= pastaTycoons do
			atual = atual.Parent
		end
		return atual
	end

	-- descobre o tipo do script pelo conteúdo
	local function tipoDoScript(s)
		local src = s.Source
		if s:IsA("ModuleScript") then
			if tem(src, "carteiras") and tem(src, "adicionarAoArmazem") then return "Economia" end
			return "Outro"
		end
		if tem(src, "entregarItens") then return "BotaoCompra" end
		if tem(src, "tentarComprar") or tem(src, "jaComprado") then return "Botao" end
		if tem(src, "tocarLaser") then return "PortaLaser" end
		if tem(src, "levarParaPlaca") or tem(src, "renascerNaPlaca") then return "PlacaDono" end
		if tem(src, 'SetAttribute("Dono"') then return "BotaoDono" end
		if tem(src, "coletarParaJogador") then return "Coletor" end
		if tem(src, 'SetAttribute("Valor", nil)') then return "DestinoFinal" end
		if tem(src, "aplicarEfeito") then return "Upgrade" end
		if tem(src, "criarBloco") then return "Gerador" end
		if tem(src, "dinheiroPorCiclo") then return "GeradorTeste" end
		if tem(src, "AssemblyLinearVelocity") then return "Esteira" end
		if tem(src, "leaderstats") then return "EconomiaUI" end
		if tem(src, "prefixo") and tem(src, "rmazem") then return "PainelArmazem" end
		if tem(src, 'SetAttribute("Valor"') and tem(src, "Debris") then return "Bloco" end
		return "Outro"
	end

	-- diz se o script está na versão mais nova
	local function estaAtualizado(tipo, src)
		if tipo == "Botao" then return tem(src, "nomesDeBotao") and tem(src, "ehDono") and tem(src, "criarTexto") end
		if tipo == "BotaoDono" then return tem(src, "esconderAoPegar") end
		if tipo == "DestinoFinal" then return tem(src, "adicionarAoArmazem(tycoon") end
		if tipo == "Coletor" then return tem(src, "coletarParaJogador(tycoon") end
		if tipo == "PainelArmazem" then return tem(src, "pegarArmazem(tycoon") end
		if tipo == "PlacaDono" then return tem(src, "tamanhoDoTexto") end
		if tipo == "EconomiaUI" then return tem(src, "PlayerRemoving") end
		if tipo == "Economia" then return tem(src, "tycoonDoJogador") end
		return true
	end

	-- diz se o valor é um número, texto, true/false, cor ou Enum
	local function ehLiteral(valor)
		return valor:match("^%-?[%d%.]+$") ~= nil
			or valor == "true" or valor == "false"
			or valor:match('^".*"$') ~= nil
			or valor:match("^Color3%.fromRGB%b()$") ~= nil
			or valor:match("^Enum%.[%w%.]+$") ~= nil
	end

	-- troca o valor de uma configuração no texto do script
	local function trocarValor(fonte, nome, valor)
		local feito = false
		local novo = fonte:gsub("\n(local%s+" .. nome .. "%s*=%s*)([^\n]*)", function(inicio, resto)
			if feito then return nil end
			feito = true
			local comentario = resto:match("(%s*%-%-.*)$") or ""
			return "\n" .. inicio .. valor .. comentario
		end)
		return novo
	end

	-- coloca no script novo as configurações que o script antigo tinha
	local function manterConfigs(antigo, modelo)
		local novo = modelo
		for nome, resto in ("\n" .. antigo):gmatch("\nlocal%s+([%w_]+)%s*=%s*([^\n]*)") do
			local valor = resto:gsub("%s*%-%-.*$", "")
			valor = valor:gsub("%s+$", "")
			if ehLiteral(valor) and novo:find("\nlocal%s+" .. nome .. "%s*=") then
				novo = trocarValor(novo, nome, valor)
			end
		end
		return novo
	end

	-- troca o script pela versão nova, mantendo as configurações
	local function atualizar(s, tipo)
		s.Source = manterConfigs(s.Source, FONTES[tipo])
	end

	-- cria um script novo com a versão nova
	local function novoScript(pai, nome, tipo, classe)
		local s = Instance.new(classe or "Script")
		s.Name = nome
		s.Source = FONTES[tipo]
		s.Parent = pai
		return s
	end

	-- lista todos os scripts do projeto com o tipo de cada um
	local function listarScripts()
		local lista = {}
		for _, servico in ipairs({ workspace, ServerScriptService, ServerStorage }) do
			for _, s in ipairs(servico:GetDescendants()) do
				local ignorar = s.Name == "CorrigirProjeto" or s.Name == "RelatorioProjeto" or s.Name == "RelatorioCorrecao"
				if s:IsA("LuaSourceContainer") and not ignorar then
					table.insert(lista, { obj = s, tipo = tipoDoScript(s) })
				end
			end
		end
		return lista
	end

	-- cria uma placa de texto numa peça
	local function criarPlacaDeTexto(peca, lado)
		local tela = Instance.new("SurfaceGui")
		tela.Face = lado
		tela.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		tela.Parent = peca

		local texto = Instance.new("TextLabel")
		texto.Size = UDim2.new(1, 0, 1, 0)
		texto.BackgroundTransparency = 1
		texto.TextScaled = true
		texto.Font = Enum.Font.GothamBold
		texto.TextColor3 = Color3.fromRGB(255, 255, 255)
		texto.TextStrokeTransparency = 0
		texto.Text = ""
		texto.Parent = tela
	end

	-- cria uma peça ancorada
	local function novaPeca(pai, nome, tamanho, posicao, cor)
		local peca = Instance.new("Part")
		peca.Name = nome
		peca.Size = tamanho
		peca.Anchored = true
		peca.CFrame = posicao
		peca.Color = cor
		peca.Parent = pai
		return peca
	end

	-- devolve um nome que ainda não existe dentro da pasta (Botao1, Botao2...)
	local function nomeLivre(pai, prefixo)
		local numero = 1
		while pai:FindFirstChild(prefixo .. numero) do
			numero += 1
		end
		return prefixo .. numero
	end

	-- devolve o ponto do meio de todas as peças da base
	local function centroDaBase(base)
		local soma = Vector3.zero
		local quantidade = 0
		for _, peca in ipairs(base:GetDescendants()) do
			if peca:IsA("BasePart") then
				soma += peca.Position
				quantidade += 1
			end
		end
		if quantidade == 0 then
			return CFrame.new(0, 5, 0)
		end
		return CFrame.new(soma / quantidade)
	end

	historico:SetWaypoint("Antes da correção do projeto")
	linha("CORREÇÃO DO PROJETO - " .. os.date("%d/%m/%Y %H:%M"))

	-- ========================================
	-- PASTAS E SCRIPTS PRINCIPAIS
	-- ========================================
	titulo("PASTAS E SCRIPTS PRINCIPAIS")

	if not pastaTycoons then
		pastaTycoons = Instance.new("Folder")
		pastaTycoons.Name = "Tycoons"
		pastaTycoons.Parent = workspace
		corrigido("pasta Tycoons criada no Workspace")
		manual("coloque as bases (Tycoon1, Tycoon2...) dentro da pasta Tycoons")
	end

	if not blocos then
		blocos = Instance.new("Folder")
		blocos.Name = "Blocos"
		blocos.Parent = ServerStorage
		corrigido("pasta Blocos criada no ServerStorage")
	end

	local economia = ServerScriptService:FindFirstChild("Economia")
	if economia and not economia:IsA("ModuleScript") then
		economia.Name = "EconomiaAntiga"
		if economia:IsA("Script") then economia.Enabled = false end
		manual("havia um Script chamado Economia no lugar do ModuleScript: ele foi renomeado para EconomiaAntiga e desligado (pode apagar)")
		economia = nil
	end
	if not economia then
		novoScript(ServerScriptService, "Economia", "Economia", "ModuleScript")
		corrigido("ModuleScript Economia criado no ServerScriptService")
	elseif not estaAtualizado("Economia", economia.Source) then
		economia.Source = FONTES.Economia
		corrigido("Economia atualizado (armazém separado por base)")
	end

	-- ========================================
	-- SCRIPTS DO TIPO ERRADO OU NO LUGAR ERRADO
	-- ========================================
	titulo("SCRIPTS NO LUGAR ERRADO")

	local temUI = false
	for _, info in ipairs(listarScripts()) do
		local s = info.obj
		local tipo = info.tipo

		-- LocalScript não roda no Workspace: troca por Script
		if s.ClassName == "LocalScript" and tipo ~= "Outro" and s:IsDescendantOf(workspace) then
			local novo = Instance.new("Script")
			novo.Name = s.Name
			novo.Source = s.Source
			novo.Parent = s.Parent
			s:Destroy()
			s = novo
			corrigido("LocalScript trocado por Script: " .. nomeCurto(novo))
		end

		-- gerador de teste antigo
		if tipo == "GeradorTeste" and s:IsA("Script") and s.Enabled then
			s.Enabled = false
			corrigido("gerador de teste desligado: " .. s:GetFullName())
		end

		-- EconomiaUI
		if tipo == "EconomiaUI" then
			temUI = true
			if not s:IsDescendantOf(ServerScriptService) then
				s.Parent = ServerScriptService
				corrigido("EconomiaUI movido para o ServerScriptService")
			end
			if not estaAtualizado("EconomiaUI", s.Source) then
				atualizar(s, "EconomiaUI")
				corrigido("EconomiaUI atualizado")
			end
		end

		-- script que precisa estar numa peça mas está em outro objeto (ex: dentro de um Fire)
		if precisaDePeca[tipo] and s.Parent and not s.Parent:IsA("BasePart") and s:IsDescendantOf(workspace) then
			local peca = nil
			local atual = s.Parent
			local nivel = 0
			while atual and nivel < 3 do
				if atual:IsA("BasePart") then
					peca = atual
					break
				end
				atual = atual.Parent
				nivel += 1
			end
			if not peca and (tipo == "Botao" or tipo == "BotaoCompra") then
				local dentro = s.Parent:FindFirstChild(tipo)
				if dentro and dentro:IsA("BasePart") then
					peca = dentro
				end
			end
			if peca then
				local antes = nomeCurto(s)
				s.Parent = peca
				corrigido(tipo .. " movido para dentro da peça certa: " .. antes .. " → " .. nomeCurto(peca))
			else
				manual(tipo .. " fora de uma peça: " .. nomeCurto(s) .. " (coloque o script dentro da peça)")
			end
		end
	end

	if not temUI then
		novoScript(ServerScriptService, "EconomiaUI", "EconomiaUI")
		corrigido("script EconomiaUI criado no ServerScriptService (dinheiro na tela)")
	end

	-- ========================================
	-- ORGANIZAÇÃO DA PASTA TYCOONS
	-- ========================================
	titulo("ORGANIZAÇÃO DA PASTA TYCOONS")

	local bases = {}
	local soltos = {}
	for _, filho in ipairs(pastaTycoons:GetChildren()) do
		if filho:IsA("Folder") or filho:IsA("Model") then
			table.insert(bases, filho)
		else
			table.insert(soltos, filho)
		end
	end

	if #bases == 0 and #soltos > 0 then
		local base = Instance.new("Folder")
		base.Name = "Tycoon1"
		base.Parent = pastaTycoons
		table.insert(bases, base)
		corrigido("base Tycoon1 criada dentro da pasta Tycoons")
	end

	for _, obj in ipairs(soltos) do
		if #bases == 1 then
			obj.Parent = bases[1]
			corrigido(obj.Name .. " estava solto na pasta Tycoons e foi movido para dentro de " .. bases[1].Name)
		else
			manual(obj.Name .. " está solto na pasta Tycoons: arraste para dentro da base certa")
		end
	end

	-- scripts de base que estão fora de qualquer base
	for _, info in ipairs(listarScripts()) do
		local s = info.obj
		if s.Parent and s:IsDescendantOf(workspace) and precisaDeBase[info.tipo] and not baseDe(s) then
			local peca = s.Parent
			if peca ~= workspace and #bases == 1 then
				local antes = peca:GetFullName()
				peca.Parent = bases[1]
				corrigido(info.tipo .. " estava fora da base e foi movido para dentro de " .. bases[1].Name .. ": " .. antes)
			else
				manual(info.tipo .. " fora de uma base: " .. s:GetFullName() .. " (arraste para dentro da base certa)")
			end
		end
	end

	-- ========================================
	-- MOLDES DE BLOCO
	-- ========================================
	titulo("MOLDES DE BLOCO")

	if #blocos:GetChildren() == 0 then
		manual("a pasta ServerStorage.Blocos está vazia: coloque pelo menos um molde (uma Part)")
	end
	for _, molde in ipairs(blocos:GetChildren()) do
		if not molde:IsA("BasePart") then
			manual(molde.Name .. " em ServerStorage.Blocos não é uma Part (troque por uma Part)")
		else
			local temBloco = false
			for _, filho in ipairs(molde:GetChildren()) do
				if filho:IsA("Script") and tipoDoScript(filho) == "Bloco" then temBloco = true end
			end
			if not temBloco then
				novoScript(molde, "Bloco", "Bloco")
				corrigido("script Bloco colocado em " .. molde.Name .. " (vale 5, mude o valor se quiser)")
			end
		end
	end

	-- ========================================
	-- CADA BASE
	-- ========================================
	for _, base in ipairs(bases) do
		titulo("BASE: " .. base.Name)

		-- peças com nome errado
		for _, obj in ipairs(base:GetDescendants()) do
			if obj:IsA("BasePart") then
				local minusculo = obj.Name:lower()
				local certo = nil
				if minusculo == "botao" or minusculo == "botão" then certo = "Botao" end
				if minusculo == "botaodono" or minusculo == "botãodono" then certo = "BotaoDono" end
				if minusculo == "botaocompra" or minusculo == "botãocompra" then certo = "BotaoCompra" end
				if minusculo == "alavanca" then certo = "Alavanca" end
				if certo and obj.Name ~= certo then
					local antigo = obj.Name
					obj.Name = certo
					corrigido("peça \"" .. antigo .. "\" renomeada para " .. certo .. ": " .. nomeCurto(obj))
				end
			end
		end

		-- pastas chamadas "Botao" (confundem com a peça Botao)
		for _, obj in ipairs(base:GetDescendants()) do
			if obj.Name == "Botao" and (obj:IsA("Folder") or obj:IsA("Model")) then
				local novo = nomeLivre(obj.Parent, "Botao")
				obj.Name = novo
				corrigido("pasta chamada \"Botao\" renomeada para " .. novo .. " (só a peça pode se chamar Botao)")
			end
		end

		-- BotaoDono
		local botaoDono = base:FindFirstChild("BotaoDono")
		if botaoDono and not botaoDono:IsA("BasePart") then botaoDono = nil end
		for _, obj in ipairs(base:GetDescendants()) do
			if obj.Name == "BotaoDono" and obj:IsA("BasePart") and obj.Parent ~= base then
				if not botaoDono then
					obj.Parent = base
					botaoDono = obj
					corrigido("BotaoDono movido para a raiz da base")
				else
					manual("BotaoDono a mais em " .. nomeCurto(obj) .. " (apague o que sobrou)")
				end
			end
		end
		if not botaoDono then
			botaoDono = novaPeca(base, "BotaoDono", Vector3.new(6, 1, 6), centroDaBase(base), Color3.fromRGB(0, 170, 255))
			corrigido("BotaoDono criado no meio da base")
			manual("posicione o BotaoDono de " .. base.Name .. " na entrada da base")
		end

		local scriptDono = nil
		for _, filho in ipairs(botaoDono:GetChildren()) do
			if filho:IsA("Script") and tipoDoScript(filho) == "BotaoDono" then scriptDono = filho end
		end
		if not scriptDono then
			novoScript(botaoDono, "BotaoDono", "BotaoDono")
			corrigido("script BotaoDono colocado no BotaoDono")
		elseif not estaAtualizado("BotaoDono", scriptDono.Source) then
			atualizar(scriptDono, "BotaoDono")
			corrigido("BotaoDono atualizado (agora some quando alguém pega a base)")
		end
		if not botaoDono:FindFirstChildWhichIsA("TextLabel", true) then
			criarPlacaDeTexto(botaoDono, Enum.NormalId.Top)
			corrigido("placa de texto criada no BotaoDono")
		end

		-- botões de compra
		for _, obj in ipairs(base:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name == "Botao" then
				if obj.Parent == base then
					local pasta = Instance.new("Folder")
					pasta.Name = nomeLivre(base, "Botao")
					pasta.Parent = base
					obj.Parent = pasta
					corrigido("Botao solto na base colocado dentro da pasta " .. pasta.Name)
					manual("coloque dentro de " .. nomeCurto(pasta) .. " os itens que esse botão vende")
				end

				local scriptBotao = nil
				for _, filho in ipairs(obj:GetChildren()) do
					if filho:IsA("Script") and tipoDoScript(filho) == "Botao" then scriptBotao = filho end
				end
				if not scriptBotao then
					novoScript(obj, "Script", "Botao")
					corrigido("script de compra colocado em " .. nomeCurto(obj.Parent) .. " (confira preco e nomeDoItem)")
				else
					if not estaAtualizado("Botao", scriptBotao.Source) then
						atualizar(scriptBotao, "Botao")
						corrigido("botão atualizado (preço e nome mantidos): " .. nomeCurto(obj.Parent))
					end
					if not scriptBotao.Enabled then
						scriptBotao.Enabled = true
						corrigido("script do botão religado: " .. nomeCurto(obj.Parent))
					end
				end
			end
		end

		-- outros scripts da base
		local contagem = {}
		for _, s in ipairs(base:GetDescendants()) do
			if s:IsA("LuaSourceContainer") and s.Parent then
				local tipo = tipoDoScript(s)
				contagem[tipo] = (contagem[tipo] or 0) + 1

				if (tipo == "DestinoFinal" or tipo == "Coletor" or tipo == "PainelArmazem" or tipo == "PlacaDono") and not estaAtualizado(tipo, s.Source) then
					atualizar(s, tipo)
					corrigido(tipo .. " atualizado: " .. nomeCurto(s.Parent))
				end

				if tipo == "PainelArmazem" and s.Parent:IsA("BasePart") and not s.Parent:FindFirstChildWhichIsA("TextLabel", true) then
					criarPlacaDeTexto(s.Parent, Enum.NormalId.Front)
					corrigido("placa de texto criada no painel: " .. nomeCurto(s.Parent))
				end

				if s:IsA("Script") and not s.Enabled and tipo ~= "Outro" and tipo ~= "GeradorTeste" then
					s.Enabled = true
					corrigido("script religado: " .. nomeCurto(s))
				end

				if tipo == "Gerador" then
					local tipoBloco = s.Source:match('\nlocal%s+tipoDeBloco%s*=%s*"([^"]*)"')
					if tipoBloco and not blocos:FindFirstChild(tipoBloco) then
						local certo = nil
						for _, molde in ipairs(blocos:GetChildren()) do
							if molde.Name:lower() == tipoBloco:lower() then certo = molde.Name end
						end
						if certo then
							s.Source = trocarValor(s.Source, "tipoDeBloco", '"' .. certo .. '"')
							corrigido("Gerador " .. nomeCurto(s.Parent) .. ": molde corrigido para " .. certo)
						else
							manual("Gerador " .. nomeCurto(s.Parent) .. ": o molde \"" .. tipoBloco .. "\" não existe em ServerStorage.Blocos")
						end
					end
				end

				if tipo == "PortaLaser" then
					local alavanca = s.Parent:FindFirstChild("Alavanca")
					if alavanca and alavanca:IsA("BasePart") then
						if not alavanca:FindFirstChildWhichIsA("ProximityPrompt") then
							local prompt = Instance.new("ProximityPrompt")
							prompt.Parent = alavanca
							corrigido("ProximityPrompt criado na Alavanca: " .. nomeCurto(s.Parent))
						end
					else
						manual("PortaLaser " .. nomeCurto(s.Parent) .. ": falta a peça Alavanca")
					end
				end

				if tipo == "Outro" and not s:IsA("ModuleScript") then
					local caminho = nomeCurto(s)
					local limpo = s.Source:gsub("%s", "")
					if limpo == "" or limpo == 'print("Helloworld!")' then
						s:Destroy()
						corrigido("script vazio apagado: " .. caminho)
					else
						local juntoDeScriptDoJogo = false
						for _, irmao in ipairs(s.Parent:GetChildren()) do
							if irmao ~= s and irmao:IsA("LuaSourceContainer") and tipoDoScript(irmao) ~= "Outro" then
								juntoDeScriptDoJogo = true
							end
						end
						if juntoDeScriptDoJogo and s:IsA("Script") and s.Enabled then
							s.Enabled = false
							corrigido("script desconhecido desligado (estava junto de um script do jogo): " .. caminho .. " (se não fizer falta, apague)")
						else
							manual("script desconhecido: " .. caminho .. " (pode ser da Toolbox, confira se é seguro)")
						end
					end
				end
			end
		end

		-- peças que faltam
		local referencia = botaoDono.CFrame

		if not contagem.Coletor then
			local coletor = novaPeca(base, "Coletor", Vector3.new(3, 3, 3), referencia * CFrame.new(-10, 2, 0), Color3.fromRGB(255, 200, 0))
			coletor.Shape = Enum.PartType.Ball
			novoScript(coletor, "Coletor", "Coletor")
			corrigido("Coletor criado ao lado do BotaoDono")
			manual("posicione o Coletor de " .. base.Name .. " onde quiser")
		end

		if not contagem.PainelArmazem then
			local painel = novaPeca(base, "PainelArmazem", Vector3.new(6, 3, 0.5), referencia * CFrame.new(-10, 6, 0), Color3.fromRGB(30, 30, 30))
			criarPlacaDeTexto(painel, Enum.NormalId.Front)
			novoScript(painel, "PainelArmazem", "PainelArmazem")
			corrigido("PainelArmazem criado em cima do Coletor")
			manual("posicione o PainelArmazem de " .. base.Name .. " (o texto fica na frente da peça)")
		end

		if not contagem.PlacaDono then
			local placa = novaPeca(base, "PlacaDono", Vector3.new(8, 4, 0.5), referencia * CFrame.new(0, 6, 0), Color3.fromRGB(30, 30, 30))
			novoScript(placa, "PlacaDono", "PlacaDono")
			corrigido("PlacaDono criada em cima do BotaoDono")
			manual("posicione a PlacaDono de " .. base.Name .. " com espaço livre na frente (é onde o dono renasce)")
		end

		if not contagem.DestinoFinal then
			manual("base " .. base.Name .. " sem DestinoFinal: coloque um no fim da esteira")
		end
		if not contagem.Gerador then
			manual("base " .. base.Name .. " sem Gerador")
		end

		-- botões grátis e com o nome padrão
		local gratis = {}
		local semNome = {}
		for _, s in ipairs(base:GetDescendants()) do
			if s:IsA("Script") and tipoDoScript(s) == "Botao" then
				local preco = s.Source:match("\nlocal%s+preco%s*=%s*([^%s%-]+)")
				local nome = s.Source:match('\nlocal%s+nomeDoItem%s*=%s*"([^"]*)"')
				if preco == "0" then table.insert(gratis, s.Parent.Parent.Name) end
				if nome == "Gerador" then table.insert(semNome, s.Parent.Parent.Name) end
			end
		end
		if #gratis > 0 then
			manual("botões grátis (preço 0): " .. table.concat(gratis, ", ") .. " (mude o preco se não for de propósito)")
		end
		if #semNome > 0 then
			manual("botões com o nome padrão \"Gerador\": " .. table.concat(semNome, ", ") .. " (troque o nomeDoItem de cada um)")
		end
	end

	-- ========================================
	-- RESULTADO
	-- ========================================
	historico:SetWaypoint("Depois da correção do projeto")
	linha("")
	linha(string.format("TOTAL: %d corrigido(s) automaticamente e %d para fazer à mão", corrigidos, manuais))
	linha("Apague o ModuleScript CorrigirProjeto e rode a verificação de novo.")

	local textos = {}
	for _, item in ipairs(linhas) do
		if item[1] == "info" then print(item[2]) else warn(item[2]) end
		table.insert(textos, item[2])
	end

	local relatorio = ServerStorage:FindFirstChild("RelatorioCorrecao")
	if relatorio then relatorio:Destroy() end
	relatorio = Instance.new("Script")
	relatorio.Name = "RelatorioCorrecao"
	relatorio.Enabled = false
	relatorio.Source = "--[==[\n" .. table.concat(textos, "\n") .. "\n]==]"
	relatorio.Parent = ServerStorage
end
