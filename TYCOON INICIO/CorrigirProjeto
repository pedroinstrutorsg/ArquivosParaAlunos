		texto.TextScaled = true
	else
		texto.TextScaled = false
		texto.TextSize = tamanhoDoTexto
	end

	texto.Parent = tela
end

-- devolve o nome do dono do jeito escolhido
local function nomeDoJogador(jogador)
	if usarApelido then
		return jogador.DisplayName
	end
	return jogador.Name
end

-- leva o personagem para a frente do lado do texto
local function levarParaPlaca(personagem)
	personagem:WaitForChild("HumanoidRootPart")
	task.wait(0.1)

	local direcao = placa.CFrame:VectorToWorldSpace(Vector3.FromNormalId(ladoDoTexto))
	local posicao = placa.Position + direcao * distanciaRenascer + Vector3.new(0, alturaRenascer, 0)
	local olhar = Vector3.new(direcao.X, 0, direcao.Z)

	if olhar.Magnitude > 0 then
		personagem:PivotTo(CFrame.lookAt(posicao, posicao + olhar))
	else
		personagem:PivotTo(CFrame.new(posicao))
	end
end

-- atualiza o texto e o renascimento quando o dono muda
local function atualizarDono()
	if conexaoRenascer then
		conexaoRenascer:Disconnect()
		conexaoRenascer = nil
	end

	local id = tycoon:GetAttribute("Dono")
	local dono = id and Players:GetPlayerByUserId(id)

	if dono then
		local separador = " "
		if quebrarLinha then
			separador = "\n"
		end
		texto.Text = textoDono .. separador .. nomeDoJogador(dono)

		if renascerNaPlaca then
			conexaoRenascer = dono.CharacterAdded:Connect(levarParaPlaca)
		end
	else
		texto.Text = textoLivre
	end
end

-- ========================================
-- QUANDO O JOGO COMEÇA
-- ========================================

-- apaga textos antigos da placa e cria o novo
for _, objeto in ipairs(placa:GetChildren()) do
	if objeto:IsA("SurfaceGui") or objeto:IsA("BillboardGui") then
		objeto:Destroy()
	end
end
criarTexto()

tycoon:GetAttributeChangedSignal("Dono"):Connect(atualizarDono)
atualizarDono()
