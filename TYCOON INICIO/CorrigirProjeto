FONTES.BotaoDono = [===[
-- ========================================
-- SCRIPT: BOTÃO DONO
-- Dá a base para o primeiro jogador que tocar,
-- some depois que a base é pega e volta quando ela fica livre
-- Local: Tycoons.TycoonX.BotaoDono
-- ========================================

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local Economia = require(ServerScriptService.Economia)

-- a peça do botão e a base onde ele está
local botaoDono = script.Parent
local tycoon = Economia.acharTycoon(botaoDono)

-- texto da placa do botão
local texto = botaoDono:FindFirstChildWhichIsA("TextLabel", true)

-- ========================================
-- CONFIGURAÇÕES
-- ========================================
local textoLivre = "Base livre"  -- texto quando a base não tem dono
local textoDono = "Base de "     -- texto antes do nome do dono
local esconderAoPegar = true     -- true: o botão some quando alguém pega a base

-- ========================================
-- VARIÁVEIS DE CONTROLE
-- ========================================
local original = {}  -- como o botão e o que tem dentro eram no Studio

-- valor de cada propriedade quando o botão está escondido
local escondido = {
	Transparency = 1,
	CanCollide = false,
	CanTouch = false,
	Enabled = false,
}

-- ========================================
-- FUNÇÕES
-- ========================================

-- anota como o botão e o que tem dentro estão no Studio
local function anotar()
	original[botaoDono] = {
		Transparency = botaoDono.Transparency,
		CanCollide = botaoDono.CanCollide,
		CanTouch = botaoDono.CanTouch,
	}
	for _, objeto in ipairs(botaoDono:GetDescendants()) do
		if objeto:IsA("Decal") then
			original[objeto] = { Transparency = objeto.Transparency }
		elseif objeto:IsA("SurfaceGui") or objeto:IsA("BillboardGui") or objeto:IsA("ParticleEmitter") or objeto:IsA("Light") then
			original[objeto] = { Enabled = objeto.Enabled }
		end
	end
end

-- esconde o botão
local function esconder()
	for objeto, propriedades in pairs(original) do
		for nome in pairs(propriedades) do
			objeto[nome] = escondido[nome]
		end
	end
end

-- mostra o botão de novo
local function mostrar()
	for objeto, propriedades in pairs(original) do
		for nome, valor in pairs(propriedades) do
			objeto[nome] = valor
		end
	end
end

-- escreve na placa o nome do dono, ou "Base livre"
local function atualizarPlaca(jogador)
	if not texto then return end
	if jogador then
		texto.Text = textoDono .. jogador.Name
	else
		texto.Text = textoLivre
	end
end

-- ========================================
-- EVENTOS
-- ========================================

-- dá a base para o jogador que tocou
botaoDono.Touched:Connect(function(hit)
	if tycoon:GetAttribute("Dono") then return end

	local jogador = Players:GetPlayerFromCharacter(hit.Parent)
	if not jogador then return end

	-- cada jogador só pode ter uma base
	if Economia.tycoonDoJogador(jogador) then return end

	tycoon:SetAttribute("Dono", jogador.UserId)
	Economia.esvaziarArmazem(tycoon)
	atualizarPlaca(jogador)

	if esconderAoPegar then
		esconder()
	end

	-- avisa os botões do térreo que podem aparecer
	botaoDono:SetAttribute("Comprado", true)

	print(jogador.Name .. " pegou a base " .. tycoon.Name)
end)

-- libera a base quando o dono sai
Players.PlayerRemoving:Connect(function(jogador)
	if tycoon:GetAttribute("Dono") ~= jogador.UserId then return end

	tycoon:SetAttribute("Dono", nil)
	Economia.esvaziarArmazem(tycoon)
	atualizarPlaca(nil)
	mostrar()

	-- avisa os botões que a base resetou
	botaoDono:SetAttribute("Comprado", nil)

	print("A base " .. tycoon.Name .. " ficou livre")
end)

-- ========================================
-- QUANDO O JOGO COMEÇA
-- ========================================
anotar()
atualizarPlaca(nil)
